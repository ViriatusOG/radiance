# Copy to .env in this directory; docker compose reads it on every command.

# The image to run: the published one, or radiance:latest for one built here with docker/build.sh
# (which also tags radiance:<version> and radiance:<commit>).
RADIANCE_IMAGE=stilldeadcode/radiance:latest

# Directory holding the .rad containers, mounted read-only at /models.
RADIANCE_MODELS=/srv/models/rad

# Every request but /health, /ping and the dashboard page must carry `Authorization: Bearer <key>`
# (or `X-Api-Key: <key>`). It enters the container through the environment (--api-key-env), not
# the command line, where every process on the host could read it in `ps`.
RADIANCE_API_KEY=

# The port the server listens on.
PORT=8000

# The user the server runs as, and the host's GPU device groups:
#   id -u; id -g; getent group render | cut -d: -f3; getent group video | cut -d: -f3
RADIANCE_UID=1000
RADIANCE_GID=1000
RENDER_GID=
VIDEO_GID=

# The card a one-card model runs on (embeddinggemma2.yaml), by index.
RADIANCE_GPU=0

# Run the container under a seccomp profile: Docker's default plus exactly the calls radiance
# needs beyond it (io_uring for the n-gram table, the NUMA binding calls) is seccomp-radiance.json
# beside this file. Give its absolute path on the host to confine; unset runs unconfined, which is
# what these files have always done, because the stock Docker default blocks radiance's startup.
#RADIANCE_SECCOMP=/srv/radiance/deploy/compose/seccomp-radiance.json
