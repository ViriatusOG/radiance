# q38-27b-iq6r-v2.recipe -- IQ6R-V2: Qwen3.8-27B on IQ8R's rotated int8 grid at ~6.375 bits a weight.
# IQR-V2: every trunk linear rotated by fwht128 and fitted by GPTQ against the calib Hessians, its
# codes a 4096-state tail-biting trellis down each column (tcq=12, tables
# data/codebooks/iqr-tcq-L12-k*.txt, 5-bit, 6-bit, 7-bit by layer band), an E4M3 scale per (row,
# 128) under one f32 for the tensor (docs/IQR.md, "IQR-V2"). libr4d decodes every code where it is
# read (gemm_iqr); served by qwen35_w8a8 at i8a8h with rotated int8 activations.
#
#   CALIB=<calib Hessians, RADGRAM2> rad-convert <Qwen3.8-27B bf16> --recipe data/recipes/q38-27b-iq6r-v2.recipe \
#       --set quantization_config.quant_method=w8a8 --set quantization_config.fmt=fwht128 -o OUT.rad
#
# The competition's private tiers 1+2: 6.375 bpw, mean KL 0.00094, top-1 98.92% (V1 IQ6R: 6.375 bpw, 0.00123).

blk.0.ssm_inz.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.0.ssm_out.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.0.ffn_gate_up.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.0.ffn_down.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.1.ssm_inz.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.1.ssm_out.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.1.ffn_gate_up.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
blk.1.ffn_down.weight gptq codes=u6 tcq=12 tcq_rows=256 tcq_lut=data/codebooks/iqr-tcq-L12-k6.txt group=128 scale=fp8_e4m3 scale2=f32 block2=*x* transform=fwht128 dyn=1 damp=0.05 calib=$CALIB
