# moss-image-iq8r.recipe -- MOSS-Image with IQ8R linears on the DiT and the trunk.
#
#   rad-convert <MOSS-Image pipeline directory> --arch mossimage \
#       --recipe data/recipes/moss-image-iq8r.recipe -o moss-image-iq8r.rad \
#       --tokenizer <dir>/tokenizer/tokenizer.json --chat-template <dir>/tokenizer/chat_template.jinja
#
# Every linear of the DiT's 42 blocks, the Qwen3.5 trunk's 8 full-attention layers' four
# projections and all 32 of its layers' MLPs become rotated int8:
# codes in -127..127 in the 128-wide Hadamard domain with a u8 scale per [1 x 256] of K under a
# bf16 scale a row, read at i8a8h against int8 activations quantised under the same rotation with
# one scale per (token, 256). Round to nearest with a scale search; no calibration data is read.
#
# The trunk's 24 delta nets are the exception its kernels state: conv1d, A_log, dt_bias, the norm
# and all three of their projections (in, z and out) stay bf16 -- the published INT8-ConvRot
# release leaves them bf16 too. What else stays bf16 is read once a pass or less: the embedding table, the
# vision tower, the DiT's text refiner (2 blocks, all with biases), the timestep MLP, the
# modulation tables, video_embedder, the final norm and head, rope.bands and the VAE.

# ---- the trunk: the 8 full-attention layers' four projections and all 32 layers' MLPs
te.blk.*.attn_qg.weight              rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.attn_k.weight               rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.attn_v.weight               rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.attn_output.weight          rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.ffn_gate_up.weight          rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.ffn_down.weight             rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search

# ---- the DiT's 42 blocks
dit.blk.*.attn_qkv.weight            rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.blk.*.attn_output.weight         rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.blk.*.ffn_gateup.weight          rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.blk.*.ffn_down.weight            rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search

vae.*                                cast dtype=bf16
