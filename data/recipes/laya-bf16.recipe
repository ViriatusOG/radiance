# laya-bf16.recipe -- Convai Innovations' Laya (laya, laya-typed-decisions, laya-multilingual) for the
# laya plugin (arch/laya).
#
#   rad-convert convaiinnovations/laya-typed-decisions --recipe data/recipes/laya-bf16.recipe \
#       -o laya-typed-decisions.rad
#
# The release ships f16. The plugin reads its linears and tables in bf16, as the release computes them
# on a card under bf16 autocast, and f16 to bf16 rounds, so it is a rule here. Norms and biases are
# declared f32, an exact widening of f16, and no rule names them.
token_embd.weight          cast dtype=bf16
type_emb.weight            cast dtype=bf16
scorer.fc1.weight          cast dtype=bf16
scorer.fc2.weight          cast dtype=bf16
blk.*.attn_qkv.weight      cast dtype=bf16
blk.*.attn_out.weight      cast dtype=bf16
blk.*.ffn_in_gate.weight   cast dtype=bf16
blk.*.ffn_down.weight      cast dtype=bf16
head.*.attn_qkv.weight     cast dtype=bf16
head.*.attn_out.weight     cast dtype=bf16
head.*.ffn_up.weight       cast dtype=bf16
head.*.ffn_down.weight     cast dtype=bf16
