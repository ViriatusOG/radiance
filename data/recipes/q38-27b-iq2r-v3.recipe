# q38-27b-iq2r-v3.recipe -- IQ2R-V3: Qwen3.8-27B at ~2.465 bits a weight.
# IQR-V3: every trunk linear rotated by fwht128 and fitted by GPTQ against the calib Hessians, its
# codes a tail-biting trellis down each column whose 2^16 states' values are computed from the
# state (tcq=16 tcq_code=mad; 2^15 at two bits) under one f32 scale a row at a gain by width,
# damping 0.01 (2-bit and 3-bit by layer band; docs/IQR.md, "IQR-V3"). The GEMM decodes the codes
# in its tile (libr4d gemm_iqr); served by qwen35_w8a8 at i8a8h with rotated int8 activations.
#
#   CALIB=<calib Hessians, RADGRAM2> rad-convert <Qwen3.8-27B bf16> --recipe data/recipes/q38-27b-iq2r-v3.recipe \
#       --set quantization_config.quant_method=w8a8 --set quantization_config.fmt=fwht128 -o OUT.rad
#
# The competition's private tiers 1+2: 2.465 bpw, mean KL 0.06807, top-1 90.54% (IQ2R-V2: 2.467 bpw, 0.07303).

blk.0.ssm_inz.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.0.ssm_out.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.0.ffn_gate_up.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.0.ffn_down.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.1.ssm_inz.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.1.ssm_out.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.1.ffn_gate_up.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.1.ffn_down.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.2.ssm_inz.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.2.ssm_out.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
blk.2.ffn_gate_up.weight gptq codes=u2 tcq=15 tcq_code=mad tcq_rows=256 block=1x* scale=f32 transform=fwht128 tcq_gain=1.04 damp=0.01 calib=$CALIB
